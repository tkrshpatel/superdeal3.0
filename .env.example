APP_ENV=development
DATABASE_URL=sqlite:///data/superdeal.db

SUPERDEAL_API_HOST=127.0.0.1
SUPERDEAL_API_PORT=8000
SUPERDEAL_DB=data/superdeal.db

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=@example_deals
TELEGRAM_POLL_INTERVAL=1
TELEGRAM_BATCH_LIMIT=100

# Reader modes:
# bot    = Bot API only
# user   = authenticated Telegram user only
# hybrid = Bot API polling + authenticated Telethon live stream; recommended for mixed channels
TELEGRAM_READER_MODE=hybrid

# Required for user/hybrid mode.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram_user

LOG_LEVEL=INFO

# EarnKaro batch conversion
API_KEY_EARNKARO=
