APP_ENV=development
DATABASE_URL=sqlite:///data/superdeal.db

# PC-hosted API. Keep 127.0.0.1 if only the PC needs the API.
# Use 0.0.0.0 only when the Android app connects over your home LAN.
SUPERDEAL_API_HOST=127.0.0.1
SUPERDEAL_API_PORT=8000
SUPERDEAL_DB=data/superdeal.db

# Telegram Bot API credentials and public channel sources.
# Never commit real credentials to this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=@example_deals
TELEGRAM_POLL_INTERVAL=1
TELEGRAM_BATCH_LIMIT=100

LOG_LEVEL=INFO
